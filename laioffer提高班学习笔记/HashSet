public static void main(String[] args) {

        List<Integer> nums = Arrays.asList(1,9,2,8,3,7);

        // 创建

        Set<Integer> hs = new HashSet<>(nums);

        System.out.println("add by List: " + hs); //[1, 9, 2, 8, 3, 7]

        // 一个个加
        
                hs.add(3);  // 实际上加不进去

                hs.add(5);

                System.out.println("add individually: " + hs); //[1, 9, 2, 8, 3, 7, 5]

                // remove

                hs.remove(5);

                System.out.println("remove: " + hs); //[1, 9, 2, 8, 3, 7]



                // contains

                System.out.println("contains 1 ? " + hs.contains(1)); //true



                // 遍历方法1: 用enhanced for loop

                System.out.print("遍历方法1： ");

                for (Integer h : hs) {

                    System.out.print(h + " "); // 1 2 3 7 8 9

                }



                System.out.println();



                // 遍历方法2：用iterator，这个的好处是可以在遍历途中删除元素，enhanced for loop不行

                Iterator<Integer> it = hs.iterator();

                while(it.hasNext()) {

                    int cur = it.next();

                    if (cur == 3) {

                        it.remove();

                    }

                }

                System.out.println("遍历方法2： " + hs); // 1 2 7 8 9

            }